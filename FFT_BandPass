clc;
clear;
close all;

% Original discrete-time signal
x = [1, 2, 0, -1, 3, 2, -2, 1];

N = length(x);
fs = 10000;
n = 0:N-1;
f = (0:N-1)*(fs/N);

% DFT
X = fft(x);

% IFFT to reconstruct the original signal
x_reconstructed = ifft(X);

% Filter frequencies between 3000 and 4000 Hz
mask = (f >= 3000 & f <= 4000) | (f >= fs-4000 & f <= fs-3000);

X_filtered = X .* mask;

% Plot all results
figure;

subplot(3,1,1);
stem(n, real(x_reconstructed), 'filled');
title('Original Signal Reconstructed Using IFFT');
xlabel('Sample Index n');
ylabel('Amplitude');
grid on;

subplot(3,1,2);
stem(f(1:N/2+1), abs(X(1:N/2+1)), 'filled');
title('Original DFT Spectrum');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

subplot(3,1,3);
stem(f(1:N/2+1), abs(X_filtered(1:N/2+1)), 'filled');
title('Filtered DFT Spectrum');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;
